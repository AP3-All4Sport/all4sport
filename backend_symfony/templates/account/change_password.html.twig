{% extends 'base.html.twig' %}

{% block title %}Modifier mon mot de passe | All4Sport{% endblock %}

{% block body %}
    <section class="account-card account-card-small">
        <p class="eyebrow">Sécurité</p>
        <h1>Modifier mon mot de passe</h1>
        <p class="account-intro">Confirmez votre mot de passe actuel avant d’en choisir un nouveau.</p>

        {{ form_start(password_form, {attr: {class: 'account-form'}}) }}
            {% for field, input in {
                'current-password': password_form.currentPassword,
                'new-password': password_form.newPassword.first,
                'new-password-confirmation': password_form.newPassword.second
            } %}
                <div class="form-field">
                    {{ form_label(input) }}
                    <div class="password-input">
                        {{ form_widget(input, {id: field}) }}
                        <button class="password-toggle" type="button" data-password-toggle="{{ field }}" aria-label="Afficher le mot de passe" aria-pressed="false"><span class="password-eye" aria-hidden="true"></span></button>
                    </div>
                    {{ form_errors(input) }}
                </div>
            {% endfor %}

            <div class="account-actions">
                <button class="button button-primary" type="submit">Enregistrer</button>
                <a class="button button-secondary" href="{{ path('app_account') }}">Annuler</a>
            </div>
        {{ form_end(password_form) }}
    </section>
{% endblock %}
