{% extends 'base.html.twig' %}

{% block title %}Nouveau mot de passe | All4Sport{% endblock %}

{% block body %}
    <nav class="account-breadcrumb" aria-label="Fil d’Ariane">
        <a href="{{ path('app_react') }}">Accueil</a>
        <span aria-hidden="true">›</span>
        <span>Nouveau mot de passe</span>
    </nav>

    <section class="account-card account-card-small account-card-focused">
        <p class="eyebrow">Sécurité</p>
        <h1>Choisissez un nouveau mot de passe</h1>
        <p class="account-intro">Utilisez au moins 6 caractères et évitez un mot de passe déjà utilisé ailleurs.</p>

        {{ form_start(reset_password_form, {attr: {class: 'account-form'}}) }}
            <div class="form-field">
                {{ form_label(reset_password_form.plainPassword.first) }}
                <div class="password-input">
                    {{ form_widget(reset_password_form.plainPassword.first, {id: 'reset-password'}) }}
                    <button class="password-toggle" type="button" data-password-toggle="reset-password" aria-label="Afficher le mot de passe" aria-pressed="false">
                        <span class="password-eye" aria-hidden="true"></span>
                    </button>
                </div>
                {{ form_errors(reset_password_form.plainPassword.first) }}
            </div>
            <div class="form-field">
                {{ form_label(reset_password_form.plainPassword.second) }}
                <div class="password-input">
                    {{ form_widget(reset_password_form.plainPassword.second, {id: 'reset-password-confirmation'}) }}
                    <button class="password-toggle" type="button" data-password-toggle="reset-password-confirmation" aria-label="Afficher le mot de passe" aria-pressed="false">
                        <span class="password-eye" aria-hidden="true"></span>
                    </button>
                </div>
                {{ form_errors(reset_password_form.plainPassword.second) }}
            </div>
            <button class="button button-primary button-wide" type="submit">Enregistrer le nouveau mot de passe</button>
        {{ form_end(reset_password_form) }}
    </section>
{% endblock %}
