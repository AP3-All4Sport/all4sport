{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié | All4Sport{% endblock %}

{% block body %}
    <nav class="account-breadcrumb" aria-label="Fil d’Ariane">
        <a href="{{ path('app_react') }}">Accueil</a>
        <span aria-hidden="true">›</span>
        <a href="{{ path('app_login') }}">Mon compte</a>
        <span aria-hidden="true">›</span>
        <span>Mot de passe oublié</span>
    </nav>

    <section class="account-card account-card-small account-card-focused">
        <div class="account-card-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M7 10V8a5 5 0 0 1 10 0v2M5 10h14v11H5zM12 15v2"/></svg>
        </div>
        <p class="eyebrow">Récupération du compte</p>
        <h1>Mot de passe oublié&nbsp;?</h1>
        <p class="account-intro">Indiquez l’adresse e-mail associée à votre compte. Le lien reçu restera valable pendant une heure.</p>

        {{ form_start(forgot_password_form, {attr: {class: 'account-form'}}) }}
            {{ form_row(forgot_password_form.email) }}
            <button class="button button-primary button-wide" type="submit">Envoyer le lien</button>
        {{ form_end(forgot_password_form) }}

        <p class="account-switch"><a href="{{ path('app_login') }}">← Retour à la connexion</a></p>
    </section>
{% endblock %}
