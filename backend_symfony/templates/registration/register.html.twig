{% extends 'base.html.twig' %}

{% block title %}Créer un compte | All4Sport{% endblock %}

{% block body %}
    <section class="account-card">
        <p class="eyebrow">Bienvenue</p>
        <h1>Créer un compte</h1>
        <p class="account-intro">Renseignez vos informations pour accéder à votre espace All4Sport.</p>

        {{ form_start(registration_form, {attr: {class: 'account-form'}}) }}
            <div class="form-grid">
                {{ form_row(registration_form.prenom) }}
                {{ form_row(registration_form.nom) }}
            </div>
            {{ form_row(registration_form.email) }}
            {{ form_row(registration_form.telephone) }}
            {{ form_row(registration_form.plainPassword.first) }}
            {{ form_row(registration_form.plainPassword.second) }}

            <button class="button button-primary" type="submit">Créer mon compte</button>
        {{ form_end(registration_form) }}

        <p class="account-switch">Déjà inscrit ? <a href="{{ path('app_login') }}">Se connecter</a></p>
    </section>
{% endblock %}
