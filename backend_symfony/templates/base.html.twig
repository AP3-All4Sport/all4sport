<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}All4Sport{% endblock %}</title>
        {% block stylesheets %}
            {{ vite_entry_link_tags('app') }}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% endblock %}
    </head>
    <body>
        <div class="store-layout">
            <div id="account-header-root"></div>

            <main class="store-content account-page">
                {% for type, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="flash flash-{{ type }}" role="status">{{ message }}</div>
                    {% endfor %}
                {% endfor %}

                {% block body %}{% endblock %}
            </main>

            <div id="account-footer-root"></div>
        </div>
        {% block javascripts %}
            {{ vite_entry_script_tags('app', { dependency: 'react' }) }}
        {% endblock %}
    </body>
</html>
